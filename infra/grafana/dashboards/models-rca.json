{
  "title": "Tracelore / models-rca",
  "uid": "tracelore-models-rca",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Open incidents",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tracelore-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "tracelore_open_incidents",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "BOCPD alarms",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tracelore-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(tracelore_bocpd_alarms_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "RCA duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tracelore-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(tracelore_rca_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Grounding rejections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tracelore-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(tracelore_rca_grounding_failures_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Archive ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tracelore-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "tracelore_compression_ratio",
          "refId": "A"
        }
      ]
    }
  ]
}
